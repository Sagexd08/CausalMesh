# CausalMesh environment configuration — copy to `.env` and adjust.
#
# The vertical slice runs entirely on the deterministic MockAgent, so NO API
# keys are required. Provider settings below are placeholders for later work
# and are read only when a real adapter is explicitly selected.
#
# Spec §89: any network access must be explicit. The slice makes none.

# ---------------------------------------------------------------------------
# Experiment identity
# ---------------------------------------------------------------------------
# Recorded on every run for attribution (§10). Not a secret.
CAUSALMESH_OPERATOR_ID=local-operator

# Root seed for all randomization. Every per-run seed derives deterministically
# from this plus the task id, so a schedule is reproducible (§40).
CAUSALMESH_MASTER_SEED=20260910

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
CAUSALMESH_DATA_DIR=./data
CAUSALMESH_ARTIFACTS_DIR=./artifacts
CAUSALMESH_WORKSPACE_DIR=./workspace

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Concurrent runs. Reproducibility is never traded for speed (§78).
CAUSALMESH_MAX_PARALLEL_RUNS=1

# DEBUG | INFO | WARNING | ERROR
CAUSALMESH_LOG_LEVEL=INFO

# Fail a confirmatory run when the working tree is dirty (§34).
# Override only deliberately, and it is recorded in the manifest.
CAUSALMESH_ALLOW_DIRTY_TREE=false

# ---------------------------------------------------------------------------
# Model providers — NOT needed for the current slice
# ---------------------------------------------------------------------------
# Leave blank unless a real adapter is being used. Never commit a real key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
