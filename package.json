{
  "name": "causalmesh-web",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace root. The site is a single Next.js app: landing page at /, docs at /docs.",
  "workspaces": [
    "docs-site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=docs-site",
    "build": "npm run build --workspace=docs-site",
    "start": "npm run start --workspace=docs-site",
    "types:check": "npm run types:check --workspace=docs-site"
  },
  "engines": {
    "node": ">=20"
  }
}
