{
  "name": "causalmesh-web",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace root. `npm run dev` starts the landing page; the docs site is a separate app.",
  "workspaces": [
    "frontend",
    "docs-site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "dev:docs": "npm run dev --workspace=docs-site",
    "build:docs": "npm run build --workspace=docs-site",
    "build:all": "npm run build && npm run build:docs"
  },
  "engines": {
    "node": ">=20"
  }
}
