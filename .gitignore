# ---------------------------------------------------------------------------
# EXPERIMENTAL DATA  (spec §31: raw data is immutable evidence)
#
# Run outputs are large, machine-specific and reproducible from configuration
# plus seed, so they are not tracked. Manifests ARE tracked: they carry the
# SHA-256 hashes that make raw evidence verifiable after the fact, and they
# are what allows a reported number to be traced back to the run producing it.
# ---------------------------------------------------------------------------
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/exports/**
!data/exports/.gitkeep

# Manifests are tracked deliberately — do not add them here.
!data/manifests/**

# ---------------------------------------------------------------------------
# Generated artifacts  (regenerated by the analysis pipeline)
# ---------------------------------------------------------------------------
artifacts/chains/**
!artifacts/chains/.gitkeep
artifacts/metrics/**
!artifacts/metrics/.gitkeep
artifacts/plots/**
!artifacts/plots/.gitkeep
artifacts/tables/**
!artifacts/tables/.gitkeep
artifacts/reports/**
!artifacts/reports/.gitkeep
artifacts/certificates/**
!artifacts/certificates/.gitkeep

# ---------------------------------------------------------------------------
# Agent workspaces  (recreated per run)
# ---------------------------------------------------------------------------
workspace/
experiments/**
!experiments/.gitkeep

# ---------------------------------------------------------------------------
# Operational databases
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Frontend build output
# ---------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
artifact.html

# ---------------------------------------------------------------------------
# Agent tooling installed by `npx skills add` — vendored third-party skill
# definitions, not project source. Tracked nowhere: they belong to the
# operator's toolchain and would otherwise pin this repo to one agent setup.
# ---------------------------------------------------------------------------
.agents/
.claude/skills/
skills-lock.json
