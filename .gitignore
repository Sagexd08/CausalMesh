# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
ENV/
env/

# ---------------------------------------------------------------------------
# Testing / tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---------------------------------------------------------------------------
# Environment / secrets  (never commit real credentials)
# ---------------------------------------------------------------------------
.env
.env.local
*.key
*.pem
secrets/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.qodo/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# EXPERIMENTAL DATA  (spec §31: raw data is immutable evidence)
#
# Run outputs are large, machine-specific and reproducible from configuration
# plus seed, so they are not tracked. Manifests ARE tracked: they carry the
# SHA-256 hashes that make raw evidence verifiable after the fact, and they
# are what allows a reported number to be traced back to the run producing it.
# ---------------------------------------------------------------------------
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/exports/**
!data/exports/.gitkeep

# Manifests are tracked deliberately — do not add them here.
!data/manifests/**

# ---------------------------------------------------------------------------
# Generated artifacts  (regenerated by the analysis pipeline)
# ---------------------------------------------------------------------------
artifacts/chains/**
!artifacts/chains/.gitkeep
artifacts/metrics/**
!artifacts/metrics/.gitkeep
artifacts/plots/**
!artifacts/plots/.gitkeep
artifacts/tables/**
!artifacts/tables/.gitkeep
artifacts/reports/**
!artifacts/reports/.gitkeep
artifacts/certificates/**
!artifacts/certificates/.gitkeep

# ---------------------------------------------------------------------------
# Agent workspaces  (recreated per run)
# ---------------------------------------------------------------------------
workspace/
# The CLI puts per-run agent workspaces under data/work/<experiment_id>/.
# They are scratch copies of a fixture and are rebuilt on every run.
data/work/**
experiments/**
!experiments/.gitkeep

# ---------------------------------------------------------------------------
# Operational databases
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Frontend build output
# ---------------------------------------------------------------------------
# Keep dependency trees local in every workspace. Package manifests and
# lockfiles remain tracked so a fresh checkout installs the same graph.
node_modules/
frontend/dist/
artifact.html

# Hosting/provider state is generated per developer or deployment and must
# never carry credentials or project-specific links into the repository.
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Agent tooling installed by `npx skills add` — vendored third-party skill
# definitions, not project source. Tracked nowhere: they belong to the
# operator's toolchain and would otherwise pin this repo to one agent setup.
# ---------------------------------------------------------------------------
.agents/
skills-lock.json

# .claude/skills/ IS tracked: these are the design skills this project was
# built with, and a future session in another checkout needs them to make
# changes that match. The impeccable binaries are excluded — they are
# platform-specific and re-downloaded on first run.
.claude/skills/impeccable/scripts/

# Fumadocs site build output
frontend/.next/
frontend/.source/

# Git worktrees for isolated agent workspaces
.worktrees/

# /brag skill: unlike the design skills above, this bundles ~17MB of music
# and SFX library assets that are regenerable/re-installable and not
# specific to how this project was built -- same reasoning as excluding
# impeccable's platform binaries above.
.claude/skills/brag/

# /brag rendered output -- generated video artifacts, not source.
brag-output/
brag-output-*/
