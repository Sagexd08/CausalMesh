{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=optional",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "docs-site/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "^/docs/?$",
      "dest": "/docs-site/index"
    },
    {
      "src": "^/docs/(.*)",
      "dest": "/docs-site/$1"
    },
    {
      "src": "^/_next/(.*)",
      "dest": "/docs-site/_next/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}

