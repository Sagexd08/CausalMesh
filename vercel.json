{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=optional",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "docs-site/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [

    {
      "handle": "filesystem"
    },
    {
      "src": "/docs",
      "dest": "/docs-site"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs-site/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
