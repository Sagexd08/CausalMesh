{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "docs-site/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/docs(?:/(.*))?",
      "dest": "/docs-site/docs/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "/docs-site/_next/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
